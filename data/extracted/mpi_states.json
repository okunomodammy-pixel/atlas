{
 "source": "National Bureau of Statistics, Nigeria Multidimensional Poverty Index 2022, Appendix D (Tables D12 and D49) and Table 2",
 "period": "survey fieldwork November 2021 to February 2022",
 "checks": "MPI = sum of weight x censored headcount for every state (within 0.004); no censored headcount above H",
 "indicators": [
  {
   "key": "nutrition",
   "name": "Nutrition",
   "dimension": "Health",
   "weight": 0.083333,
   "deprived_if": "a child under 5 is stunted or underweight, or an adult is underweight"
  },
  {
   "key": "food",
   "name": "Food insecurity",
   "dimension": "Health",
   "weight": 0.083333,
   "deprived_if": "the household is severely food insecure (FAO Food Insecurity Experience Scale)"
  },
  {
   "key": "health_time",
   "name": "Time to healthcare",
   "dimension": "Health",
   "weight": 0.083333,
   "deprived_if": "the nearest health facility is 30 minutes or more away on foot"
  },
  {
   "key": "attendance",
   "name": "School attendance",
   "dimension": "Education",
   "weight": 0.09375,
   "deprived_if": "a child aged 6-15 is not attending school"
  },
  {
   "key": "schooling",
   "name": "Years of schooling",
   "dimension": "Education",
   "weight": 0.125,
   "deprived_if": "no one aged 15 or over has completed primary school"
  },
  {
   "key": "school_lag",
   "name": "School lag",
   "dimension": "Education",
   "weight": 0.03125,
   "deprived_if": "a child aged 8-17 is two or more grades behind"
  },
  {
   "key": "water",
   "name": "Water",
   "dimension": "Living standards",
   "weight": 0.041667,
   "deprived_if": "no safe drinking water"
  },
  {
   "key": "water_rel",
   "name": "Water reliability",
   "dimension": "Living standards",
   "weight": 0.041667,
   "deprived_if": "water is available fewer than 20 days a month or 4 hours a day"
  },
  {
   "key": "sanitation",
   "name": "Sanitation",
   "dimension": "Living standards",
   "weight": 0.041667,
   "deprived_if": "the toilet is unimproved, or shared with other households"
  },
  {
   "key": "housing",
   "name": "Housing materials",
   "dimension": "Living standards",
   "weight": 0.041667,
   "deprived_if": "the floor, roof or walls are natural or rudimentary"
  },
  {
   "key": "cooking",
   "name": "Cooking fuel",
   "dimension": "Living standards",
   "weight": 0.041667,
   "deprived_if": "the household cooks with dung, wood or charcoal"
  },
  {
   "key": "assets",
   "name": "Assets",
   "dimension": "Living standards",
   "weight": 0.041667,
   "deprived_if": "the household has fewer than two of the listed assets and no car"
  },
  {
   "key": "unemployment",
   "name": "Unemployment",
   "dimension": "Work and shocks",
   "weight": 0.1,
   "deprived_if": "a member aged 15 or over is unemployed and looking for work"
  },
  {
   "key": "underemployment",
   "name": "Underemployment",
   "dimension": "Work and shocks",
   "weight": 0.05,
   "deprived_if": "a member works under 40 hours a week and wants more"
  },
  {
   "key": "shock",
   "name": "Security shock",
   "dimension": "Work and shocks",
   "weight": 0.1,
   "deprived_if": "the household suffered a security shock in the past 12 months"
  }
 ],
