.word-container {
    display: none; /* Hidden by default */
    position: relative;
    width: 100%;
    justify-content: center;
    align-items: center;
    height: 6vh;
    background-color: #f0f0f0;
	text-align: center;
}

.word {
    position: absolute;
    font-size: 1.1em;
	animation: fadeSequence 30s infinite;
	opacity: 0;
	
}

/* Hello */
#hello {
    animation-delay: 0s;
}

/* World */
#world {
    animation-delay: 6s;
}

/* Welcome */
#welcome {
    animation-delay: 12s;
}

/* Abraham */
#hi {
    animation-delay: 18s;
}

/* Moses */
#bye {
    animation-delay: 24s;
}

@keyframes fadeSequence {
    0% {
        opacity: 0;
		
    }

    /* Fade in */
    10% {
        opacity: 0;
		
    }

    /* Stay visible */
    30% {
        opacity: 1;
		
    }

    /* Fade out */
    40% {
        opacity: 0;
		
    }

    100% {
        opacity: 0;
    }
}

@media screen and (max-width: 768px) {
    .word-container {
        display: flex;
		flex-direction: column;
        width: 100%;
		
    }
} 

	</style>

  
