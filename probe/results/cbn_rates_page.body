<div id="chart"></div>
 <script>

      // Create the chart
      function createChart() {
        $("#chart").kendoChart({
          title: {
            text: "Exchange Rates"
          },
          legend: {
            position: "right"
          },

          dataSource: {
            transport: {
              read: {
                url: "/api/GetAllExchangeRatesGRAPH",
                dataType: "json"
              }
            },
            group: {
              field: "currency",
              dir: "asc"
            },
            sort: {
              field: "ratedate",
              dir: "asc"
            },
            schema: {
              parse: function(response) {
                var data = [];
                for (var i = 0; i < response.length; i++) {
                  var product = {
                    id: response[i].id,
                    sellingrate: response[i].sellingrate,
                    ratedate: new Date(response[i].ratedate),
                    currency: response[i].currency,
                  };
                  data.push(product);
                }
                return data;
              }
            }
          },
          seriesDefaults: {
            type: "line"

          },
          tooltip: {
            visible: true,
            format: "{0}"
          },
          series: [{
            field: "sellingrate",
            categoryField: "ratedate"
          }],
          categoryAxis: {
            labels: {
              rotation: -45,
              dateFormats: {
                days: "dd/MM/yyyy"
              }
            },
            title: {
              text: "Date"
            },
            baseUnit: "days",
            baseUnitStep: "2"
          },
          valueAxis: {

            title: {
              text: "Naira (=N=) - Selling Rate"
            }
          }

        });
      };

      $(document).ready(createChart);
    </script>
