                            <h2>Inflation Rate</h2>
					                           <div id="chart"></div>
 <script>

      // Create the chart
      function createChart() {
        $("#chart").kendoChart({
          title: {
            text: "Inflation"
          },
          legend: {
            position: "right"
          },

          dataSource: {
            transport: {
              read: {
                url: "/api/GetAllInflationRatesGRAPH",
                dataType: "json"
              }
		
            },
            
          },
          seriesDefaults: {
            type: "line"

          },
          tooltip: {
            visible: true,
            format: "{0}"
          },
          series: [{
            name: "All Items(YoCh.)",
            field: "allItemsYearOn"
        }, {
            name: "All Items(12 mon Avg.Ch.)",
            field: "allItemsAverage"
	}, {
	    name: "Food(YoCh.)",
            field: "foodYearOn"
        }, {
            name: "Food(12 mon Avg.Ch.)",
            field: "foodAverage"
	}, {
	    name: "All Items Less Farm Produce(YoCh.)",
            field: "allItemsLessFrmProdYearOn"
        }, {
            name: "All Items Less Farm Produce(12 mon Avg.Ch.)",
            field: "allItemsLessFrmProdAverage"
	}, {
	    name: "All Items Less Farm Produce & Energy(YoCh.)",
            field: "allItemsLessFrmProdAndEnergyYearOn"
        }, {
            name: "All Items Less Farm Produce & Energy(12 mon Avg.Ch.)",
            field: "allItemsLessFrmProdAndEnergyAvg"
	    
          }],
          categoryAxis: {
            field: "period",
	    title: {
              text: "Date"
            },
	    labels: {
              rotation: -45
              }
          },
          valueAxis: {

            title: {
              text: "Percent(%)"
            }
          }

        });
      };

      $(document).ready(createChart);
    </script>
