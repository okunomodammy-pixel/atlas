</table>
<table id="data-table" cellpadding = "7" class="table-bordered" style="float:left; width:45%; margin-bottom:20px;">
    <tbody id="table-body">
        <!-- Table cells will be populated dynamically -->
    </tbody>
</table>

<div id="pagination-buttons" class="mt-3" style="clear:both;">
    <button id="prev-btn" class="btn btn-primary">Previous</button>
    &nbsp;&nbsp;<span id="pagination-info"></span>&nbsp;&nbsp;
    <button id="next-btn" class="btn btn-primary">Next</button>
</div><br>
 <button onclick="exportToExcel()" class="btn btn-primary mt-2">Export to Excel</button>
</div>
<script>
// Function to fetch JSON data from an endpoint
function fetchJSONData(url) {
    return fetch(url)
        .then(response => response.json())
        .catch(error => console.error('Error fetching data:', error));
}

// Function to paginate the table by columns
function paginateTableByColumns(data, page, pageSize) {
    const startIndex = (page - 1) * pageSize;
    const endIndex = startIndex + pageSize;
    return data.map(row => row.slice(startIndex, endIndex));
}

// Function to display the table
function displayTable(paginatedData) {
    const tableBody = document.getElementById('table-body');
    tableBody.innerHTML = '';
    paginatedData.forEach(row => {
        const tr = document.createElement('tr');
        row.forEach(cellData => {
            const td = document.createElement('td');
            td.textContent = cellData;
            tr.appendChild(td);
        });
        tableBody.appendChild(tr);
    });
}

// Function to display pagination info
function updatePaginationInfo(page, totalPages) {
    const paginationInfo = document.getElementById('pagination-info');
    paginationInfo.textContent = `Page ${page} of ${totalPages}`;
}

// Initial setup
const apiUrl = "/api/GetAllInflationRates"; // Replace with your API URL
const pageSize = 3; // Number of columns per page
let currentPage = 1;
let totalColumns = 0;
let data = [];
let trunc_data = [];
// Fetch JSON data from the endpoint
fetchJSONData(apiUrl)
    .then(jsonData => {

	//
	trunc_data = jsonData;

        // Extract table data from JSON response
	data = jsonData.map(row => Object.values(row));
	
	
	data = data[0].map((col, i) => data.map(row => row[i]));
	data = data.slice(3);
	
        totalColumns = data.length > 0 ? data[0].length : 0;

        // Paginate and display initial table
        const totalPages = Math.ceil(totalColumns / pageSize);
        const paginatedData = paginateTableByColumns(data , currentPage, pageSize);
        displayTable(paginatedData);
        updatePaginationInfo(currentPage, totalPages);
    });

// Pagination buttons click events
document.getElementById('prev-btn').addEventListener('click', () => {
    if (currentPage > 1) {
        currentPage--;
        const paginatedData = paginateTableByColumns(data, currentPage, pageSize);
        displayTable(paginatedData);
        updatePaginationInfo(currentPage, Math.ceil(totalColumns / pageSize));
    }
});

document.getElementById('next-btn').addEventListener('click', () => {
    const totalPages = Math.ceil(totalColumns / pageSize);
    if (currentPage < totalPages) {
        currentPage++;
        const paginatedData = paginateTableByColumns(data, currentPage, pageSize);
        displayTable(paginatedData);
        updatePaginationInfo(currentPage, totalPages);
    }
});




    // Function to export data to Excel
    function exportToExcel() {
   
	const keyToRemove = "id";

// Loop through each object in the array
trunc_data.forEach(obj => {
  // Check if the key exists in the object
  if (obj.hasOwnProperty(keyToRemove)) {
    // If the key exists, remove it from the object
    delete obj[keyToRemove];
  }
});

	const aoo = trunc_data;
	var ws = XLSX.utils.json_to_sheet(aoo);
    	/* create workbook and export */
    	var wb = XLSX.utils.book_new();
    	XLSX.utils.book_append_sheet(wb, ws, "Sheet1");
    	XLSX.writeFile(wb, "Inflation_Data_in_Excel.xlsx");
    }


   
</script>


